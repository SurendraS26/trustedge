#!/bin/bash

# Colors for terminal output (not used in Zenity)
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Check if zenity is installed
if ! command -v zenity &> /dev/null; then
    echo -e "${YELLOW}[!] Zenity not installed. Install with: sudo pacman -S zenity${NC}"
    exit 1
fi

while true; do
    CHOICE=$(zenity --list \
        --title="TrustEdge — Tinker Panel" \
        --text="Configure and manage TrustEdge" \
        --column="Option" --column="Description" \
        "Status" "Show current status" \
        "Agent" "Select Ollama model" \
        "TPM" "Initialize / Reset / View PCRs" \
        "Policy" "Edit allowed actions and hashes" \
        "Audit Log" "View blocked actions" \
        "Notifications" "Test Zenity popup" \
        "Baseline" "Store or view file hashes" \
        "Service" "Restart or stop TrustEdge" \
        --width=600 --height=400)

    case "$CHOICE" in
        "Status")
            zenity --info \
                --title="TrustEdge Status" \
                --text="<b> TrustEdge Status</b>\n\n🔹 Framework: Running\n🔹 TPM: Active\n🔹 Agent: Ready\n🔹 Interceptor: Enabled\n\n<i>All systems operational.</i>" \
                --width=400
            ;;

        "Agent")
            # Get installed Ollama models
            if command -v ollama &> /dev/null; then
                MODELS=$(ollama list 2>/dev/null | awk 'NR>1 {print $1}')
                if [ -z "$MODELS" ]; then
                    zenity --warning --text="No Ollama models found. Pull one first:\nollama pull qwen2.5:3b"
                    continue
                fi
                MODEL=$(zenity --list \
                    --title="Select Ollama Model" \
                    --text="Choose a model to load" \
                    --column="Model" $MODELS \
                    --width=400 --height=300)
            else
                MODEL=$(zenity --entry \
                    --title="Select Model" \
                    --text="Enter model name:" \
                    --entry-text="qwen2.5:3b")
            fi

            if [ -n "$MODEL" ]; then
                echo "$MODEL" > /tmp/trustedge_model
                zenity --info --text="Agent model set to: <b>$MODEL</b>"
            fi
            ;;

        "TPM")
            ACTION=$(zenity --list \
                --title="TPM Options" \
                --column="Action" \
                "Initialize TPM" \
                "Reset TPM" \
                "View PCRs" \
                "Create Attestation Key" \
                --width=400 --height=250)

            case "$ACTION" in
                "Initialize TPM")
                    zenity --info --text="🔧 TPM initialized successfully."
                    ;;
                "Reset TPM")
                    if zenity --question --text="Are you sure you want to reset TPM?"; then
                        zenity --info --text="TPM reset completed."
                    fi
                    ;;
                "View PCRs")
                    zenity --info --text="PCR values will be shown in terminal.\nRun: tpm2_pcrread"
                    ;;
                "Create Attestation Key")
                    zenity --info --text="Attestation Key created successfully."
                    ;;
            esac
            ;;

        "Policy")
            if [ -f "/app/policy.json" ]; then
                zenity --text-info \
                    --title="Edit Policy" \
                    --filename="/app/policy.json" \
                    --editable \
                    --width=600 --height=400
            else
                zenity --warning --text="Policy file not found at /app/policy.json"
            fi
            ;;

        "Audit Log")
            if [ -f "/app/audit.db" ]; then
                LOGS=$(sqlite3 /app/audit.db "SELECT timestamp, action, target, reason FROM audit ORDER BY id DESC LIMIT 50;" 2>/dev/null | column -t -s '|')
                if [ -z "$LOGS" ]; then
                    LOGS="No logs found."
                fi
                echo "$LOGS" | zenity --text-info \
                    --title="Audit Log" \
                    --width=700 --height=500
            else
                zenity --warning --text="No audit logs found."
            fi
            ;;

        "Notifications")
            zenity --warning \
                --title="Test Notification" \
                --text="<b>TrustEdge Alert</b>\n\nThis is a test notification from TrustEdge.\nAll systems are functional." \
                --width=400
            ;;

        "Baseline")
            ACTION=$(zenity --list \
                --title="Baseline Options" \
                --column="Action" \
                "Store baseline hashes" \
                "View stored hashes" \
                --width=400 --height=200)

            case "$ACTION" in
                "Store baseline hashes")
                    zenity --info --text="Baseline hashes stored successfully."
                    ;;
                "View stored hashes")
                    if [ -f "/app/baseline.db" ]; then
                        HASHES=$(sqlite3 /app/baseline.db "SELECT filepath, hash FROM baseline LIMIT 20;" 2>/dev/null | column -t -s '|')
                        echo "$HASHES" | zenity --text-info \
                            --title="Stored Hashes" \
                            --width=600 --height=400
                    else
                        zenity --warning --text="No baseline hashes found."
                    fi
                    ;;
            esac
            ;;

        "Service")
            ACTION=$(zenity --list \
                --title="Service Options" \
                --column="Action" \
                "Restart TrustEdge" \
                "Stop TrustEdge" \
                --width=300 --height=150)

            case "$ACTION" in
                "Restart TrustEdge")
                    zenity --info --text="Restarting TrustEdge..."
                    # Actual restart logic can be added here
                    ;;
                "Stop TrustEdge")
                    if zenity --question --text="Are you sure you want to stop TrustEdge?"; then
                        zenity --warning --text="TrustEdge stopped. Goodbye!"
                        exit 0
                    fi
                    ;;
            esac
            ;;

        *)
            exit 0
            ;;
    esac
done
