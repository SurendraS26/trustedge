# TrustEdge native environment configuration
# Copied to ../.env by native/install.sh on first run.
# This is the same .env consulted by tools/trustedge-tricks.sh.

# ---- c1: AI Agent ----
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://127.0.0.1:11434
FRAMEWORK_URL=http://127.0.0.1:8000/evaluate

# ---- c1: RAG (local document grounding) ----
EMBED_MODEL=mxbai-embed-large
RAG_TOP_K=4

# ---- TPM (swtpm, native systemd service) ----
TPM_SERVER_PORT=2321
TPM_CTRL_PORT=2322
TCTI=swtpm:host=127.0.0.1,port=2321

# ---- Framework (native systemd service) ----
FRAMEWORK_PORT=8000
DASHBOARD_PORT=8501
SQLITE_PATH=__HOME__/.local/share/trustedge/data/trustedge.db
ALERT_TIMEOUT_SECONDS=30

# X11 for Zenity popups - native means these run directly on your
# session, no container display passthrough needed.
DISPLAY=:0
