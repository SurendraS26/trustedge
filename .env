# TrustEdge environment configuration
# Copy this file to .env and adjust values for your host.

# ---- c1: AI Agent ----
OLLAMA_MODEL=mistral:7b
OLLAMA_HOST=http://localhost:11434
FRAMEWORK_URL=http://c3:8000/evaluate

# ---- c1: RAG (local document grounding) ----
# Drop .txt / .md / .pdf files in c1/data - they're indexed automatically
# on every container boot and used to ground the agent's decisions.
EMBED_MODEL=mxbai-embed-large
RAG_TOP_K=4

# ---- c2: TPM (swtpm) ----
TPM_SERVER_PORT=2321
TPM_CTRL_PORT=2322

# ---- c3: Framework ----
TPM_HOST=c2
TCTI=swtpm:host=c2,port=2321
FRAMEWORK_PORT=8000
DASHBOARD_PORT=8501
SQLITE_PATH=/data/trustedge.db
ALERT_TIMEOUT_SECONDS=30

# X11 for Zenity popups (Linux host only). Leave empty to force notify-send fallback.
DISPLAY=:0
